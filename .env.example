# Local development example only. Copy to .env and replace every placeholder.
# Never commit .env, credentials, private data, or production configuration.

# Required in every environment. Supported values will be validated by the app.
STRANGE_NOVELTY_ENV=development

# Required. Use a PostgreSQL database dedicated to this environment.
# Placeholder URI only; do not reuse production accounts or databases locally.
DATABASE_URL=postgresql://<local-user>:<local-password>@<local-host>:<local-port>/<local-database>

# Required. Generate a unique local value. Never reuse a production signing key.
DJANGO_SECRET_KEY=<generate-a-unique-local-secret>

# Development-only placeholder. Production must use an explicit allowlist and
# must fail closed when it is missing or invalid.
DJANGO_ALLOWED_HOSTS=<local-host>

# Required in production and restricted to protected origins. Local development
# may omit it until cross-origin protection is explicitly needed.
DJANGO_CSRF_TRUSTED_ORIGINS=<https-origin>

# Development may enable debugging explicitly. Production must reject true.
DJANGO_DEBUG=true

# AI assistance is disabled by default. local_fake is deterministic, performs no
# network access, and is allowed only for explicit local development.
AI_ENABLED=false
AI_ADAPTER=disabled
AI_MODEL=
AI_MODEL_WRITING=
AI_MODEL_WRITING_ALTERNATE=
AI_MODEL_OUTLINING=
AI_MODEL_BRAINSTORMING=
AI_MODEL_ANALYSIS=
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=4000
DECK_AUDIT_ROOT=
MFA_ENFORCED=false
MFA_ENCRYPTION_KEY=<inject-a-dedicated-fernet-key>
WEBAUTHN_RP_ID=<relying-party-domain>
WEBAUTHN_ORIGIN=https://<application-origin>
WEBAUTHN_RP_NAME=Strange Novelty

# Production operations. Development may use the shown non-secret classifications;
# production must inject explicit bounded release values and a role.
SERVICE_ROLE=web
RELEASE_VERSION=<release-version>
SOURCE_COMMIT=<source-commit>
BUILD_IDENTIFIER=<build-identifier>
CONFIGURATION_SCHEMA_VERSION=config-v1
MAINTENANCE_MODE=false
TRUST_PROXY_HEADERS=false
DATABASE_CONN_MAX_AGE=60
MAX_REQUEST_BYTES=4100000
LOG_LEVEL=INFO
WEB_WORKERS=2
WEB_TIMEOUT_SECONDS=30
WEB_GRACEFUL_TIMEOUT_SECONDS=30
WORKER_BATCH_SIZE=1
WORKER_IDLE_SECONDS=1

# Private file storage. Development defaults to a non-public local filesystem.
# Hosted environments may select a private S3-compatible bucket. Credentials
# are environment-only and every value below is a placeholder.
PRIVATE_STORAGE_BACKEND=filesystem
PRIVATE_MEDIA_ROOT=<local-private-media-directory>
PRIVATE_STORAGE_BUCKET=<private-bucket-name>
PRIVATE_STORAGE_ENDPOINT_URL=<https-s3-compatible-endpoint>
PRIVATE_STORAGE_REGION=<provider-region-or-auto>
PRIVATE_STORAGE_ACCESS_KEY_ID=<bucket-scoped-access-key>
PRIVATE_STORAGE_SECRET_ACCESS_KEY=<bucket-scoped-secret-key>
PRIVATE_STORAGE_CUSTOM_DOMAIN=
PRIVATE_STORAGE_ADDRESSING_STYLE=auto
PRIVATE_STORAGE_SIGNATURE_VERSION=s3v4
PRIVATE_STORAGE_UPLOAD_PREFIX=uploads
PRIVATE_STORAGE_EXPORT_PREFIX=exports

# Production notes:
# - inject configuration and secrets through the selected external mechanism;
# - use production-only database credentials, keys, storage, and providers;
# - require protected transport and explicit host/origin settings;
# - fail closed when any required production value is absent or unsafe;
# - never derive production values from this example file.
