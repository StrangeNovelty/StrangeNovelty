# Local development example only. Copy to .env and replace every placeholder.
# Never commit .env, credentials, private data, or production configuration.

# Required in every environment. Supported values will be validated by the app.
STRANGE_NOVELTY_ENV=development

# Required. Use a PostgreSQL database dedicated to this environment.
# Placeholder URI only; do not reuse production accounts or databases locally.
DATABASE_URL=postgresql://<local-user>:<local-password>@<local-host>:<local-port>/<local-database>

# Required. Generate a unique local value. Never reuse a production signing key.
DJANGO_SECRET_KEY=<generate-a-unique-local-secret>

# Development-only placeholder. Production must use an explicit allowlist and
# must fail closed when it is missing or invalid.
DJANGO_ALLOWED_HOSTS=<local-host>

# Required in production and restricted to protected origins. Local development
# may omit it until cross-origin protection is explicitly needed.
DJANGO_CSRF_TRUSTED_ORIGINS=<https-origin>

# Development may enable debugging explicitly. Production must reject true.
DJANGO_DEBUG=true

# Production notes:
# - inject configuration and secrets through the selected external mechanism;
# - use production-only database credentials, keys, storage, and providers;
# - require protected transport and explicit host/origin settings;
# - fail closed when any required production value is absent or unsafe;
# - never derive production values from this example file.
